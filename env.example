# Configuración del Servidor
PORT=3000
HOST=0.0.0.0

# Modo de Aplicación
# 'test' = sin autenticación (saltar pantalla de login)
# 'secure' = con autenticación (requiere login)
APP_MODE=secure

# Configuración JWT (solo modo secure)
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Usuarios (solo modo secure)
# Generar hash con: node -e "console.log(require('bcryptjs').hashSync('tu_password', 10))"
SARA_PASSWORD_HASH=
SERGIO_PASSWORD_HASH=
